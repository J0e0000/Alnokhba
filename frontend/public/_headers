# Cache hygiene (Netlify / Cloudflare Pages both honor this file).
# index.html must always revalidate so iPhones pick up new hashed assets
# immediately after a redeploy; hashed assets are immutable forever.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
