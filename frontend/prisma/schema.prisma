// NOKHBA V1 — Prisma Schema (SQLite)
// Recreated faithfully from the original Supabase schema, preserving entity
// relationships, QR tokens, attendance, exams, homework, video links and
// notifications. Every table carries teacher_id for strict data isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Teacher / Account
// ─────────────────────────────────────────────────────────────────────────────
model Teacher {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  phone          String?
  centerName     String?
  // 'trial' | 'active' | 'expired' | 'cancelled'
  subscriptionStatus String @default("trial")
  subscriptionExpiresAt DateTime @default(now())
  absenceThreshold Int     @default(3)
  whatsappNumber  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  groups         Group[]
  students       Student[]
  lessons        Lesson[]
  exams          Exam[]
  examResults    ExamResult[]
  homework       Homework[]
  notifications  Notification[]
  qrTokens       QrToken[]
  resetTokens    PasswordReset[]
  attendance     Attendance[]
}

model PasswordReset {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Groups
// ─────────────────────────────────────────────────────────────────────────────
model Group {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name       String
  stage      String   // ابتدائي | إعدادي | ثانوي
  // 0=الأحد ... 6=السبت  (JSON array of integers, e.g. "[1,3]")
  scheduleDays String @default("[]")
  scheduleTime String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students   Student[]
  lessons    Lesson[]
  exams      Exam[]
  homework   Homework[]

  @@index([teacherId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Students  (orderIdx = manual ordering/ranking inside group)
// ─────────────────────────────────────────────────────────────────────────────
model Student {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  groupId    String?
  group      Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name       String
  phone      String?
  stage      String?
  code       String?
  orderIdx   Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attendance Attendance[]
  results    ExamResult[]
  hwStatus   HomeworkStatus[]
  qrTokens   QrToken[]

  @@index([teacherId])
  @@index([groupId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Lessons  (a scheduled session for a group; attendance attaches here)
// ─────────────────────────────────────────────────────────────────────────────
model Lesson {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title      String
  topic      String?
  // ISO date string (yyyy-mm-dd) for the lesson day
  lessonDate String
  startTime  String?
  endTime    String?
  // 'open' | 'closed' — open = attendance in progress
  status     String   @default("open")
  closedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attendance Attendance[]
  homework   Homework[]
  videoUrl   String?

  @@index([teacherId])
  @@index([groupId])
  @@index([lessonDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Attendance  (one record per student per lesson)
// ─────────────────────────────────────────────────────────────────────────────
model Attendance {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // 'present' | 'absent' | 'late' | 'excused'
  status     String   @default("absent")
  method     String   @default("manual") // 'qr' | 'manual' | 'auto'
  recordedAt DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([teacherId])
  @@index([lessonId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Exams  +  Results
// ─────────────────────────────────────────────────────────────────────────────
model Exam {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  title       String
  description String?
  // simple question text store (JSON of {questions:[{text, type, choices, answer, marks}]})
  // kept minimal — Question Bank is NOT core, but we store enough to render
  questionsJson String @default("[]")
  maxScore    Float    @default(20)
  passScore   Float?
  lessonDate  String?
  // 'draft' | 'published' | 'closed'
  status      String   @default("draft")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  results     ExamResult[]

  @@index([teacherId])
  @@index([groupId])
}

model ExamResult {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score      Float    @default(0)
  // 'pending' | 'submitted' | 'graded'
  status     String   @default("pending")
  submittedAt DateTime?
  gradedAt   DateTime?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([teacherId])
  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Homework  (attached to a lesson/group)
// ─────────────────────────────────────────────────────────────────────────────
model Homework {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lessonId   String?
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title      String
  description String?
  dueDate    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  status     HomeworkStatus[]

  @@index([teacherId])
  @@index([groupId])
}

model HomeworkStatus {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  done       Boolean  @default(false)
  markedBy   String   @default("teacher") // 'teacher' | 'student'
  updatedAt  DateTime @updatedAt

  @@unique([homeworkId, studentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// QR Tokens  (permanent per-student; /qr/[token] = student+parent portal)
// ─────────────────────────────────────────────────────────────────────────────
model QrToken {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  token      String   @unique
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications  (event-based; scoped to teacher OR student/parent via token)
// ─────────────────────────────────────────────────────────────────────────────
model Notification {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // 'teacher' | 'student' | 'parent'
  audience   String   @default("teacher")
  studentId  String?
  // 'absence' | 'warning' | 'homework' | 'video' | 'exam' | 'result' | 'lesson' | 'message'
  type       String
  title      String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([teacherId])
  @@index([studentId])
}
